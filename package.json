{
  "name": "durable-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event-sourced LLM agent runtime: exactly-once tool side effects across crashes, and trajectory-level regression eval.",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --exclude 'web/**' server/index.ts",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
